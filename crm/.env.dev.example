# Names only. Inject values at runtime; never commit a populated env file.
# Use an isolated dev database and its roles, never production connection strings.
# Set PROVIDER_MODE to stub and both outbound switches to false for dev.
APP_BASE_URL=
DATABASE_URL=
DATABASE_URL_AUTH=
DATABASE_URL_WORKER=
DATABASE_URL_BACKUP=
BETTER_AUTH_SECRET=
APP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
PROVIDER_MODE=
OUTBOUND_ENABLED=
ELEVENLABS_LIVE_ENABLED=
# Automation checks and DEV resource provisioning only (not browser config).
DEV_PORTAL_URL=
TEST_PHONE=
n8n_vps=
ELEVENLABS_API_KEY_blitz=
CAL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional local development persona previews; false by default and forced off in production.
DEV_PERSONA_SWITCHING=
