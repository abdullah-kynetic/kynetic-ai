    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.3",
    "react-resizable-panels": "^4.14.5",
    "react-responsive": "^10.0.1",
    "recharts": "3.10.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.3",
    "vaul": "^1.1.2",
