{
  "name": "kynetic-crm",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Kynetic AI"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && bun run format",
    "lint:strict": "oxlint --deny-warnings",
    "format": "oxfmt --write . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "format:check": "oxfmt --check . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "db:generate-custom": "drizzle-kit generate --custom",
    "db:migrate": "bun src/server/db/migrate.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@base-ui/utils": "0.5.0",
