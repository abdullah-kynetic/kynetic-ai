{
  "name": "kynetic-crm",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Kynetic AI"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && bun run format",
    "lint:strict": "oxlint --deny-warnings",
    "format": "oxfmt --write . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "format:check": "oxfmt --check . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "e2e:server": "bun tests/e2e/server.ts",
    "demo": "bun tests/demo/serve.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "llm:eval": "bun scripts/llm-eval.ts",
    "verify": "bash scripts/verify.sh full",
    "verify:quick": "bash scripts/verify.sh quick",
    "verify:e2e": "bash scripts/verify.sh e2e",
    "db:generate-custom": "drizzle-kit generate --custom",
    "db:migrate": "bun src/server/db/migrate.ts",
    "db:seed": "bun src/server/db/seed/index.ts",
    "db:seed:prospects": "bun src/server/db/seed/prospects-cli.ts",
    "db:seed:demo-clients": "bun src/server/db/seed/demo-clients-cli.ts",
    "db:remove:demo-clients": "bun src/server/db/seed/demo-clients-remove-cli.ts",
    "db:remove:tenants": "bun src/server/db/seed/prospects-remove-cli.ts",
    "monitor:check": "bun src/server/monitoring/cli.ts",
    "preview:check": "bun src/server/preview/check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@base-ui/utils": "0.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-auth": "1.7.13",
    "better-call": "1.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "input-otp": "^1.5.0",
    "kbar": "^1.0.0",
    "motion": "^14.2.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.10.2",
    "pdfkit": "0.20.2",
    "pg-boss": "^12.38.0",
    "postcss": "8.5.30",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.14",
    "recharts": "3.10.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uqr": "^0.1.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "24.19.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
