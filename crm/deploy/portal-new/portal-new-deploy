#!/bin/bash
# Root-owned deploy tool for the portal-new Compose project (/opt/portal-new). Installed at
# /usr/local/sbin/portal-new-deploy and reachable only through portal-new-deploy-entry via sudo.
#
#   status            running images, health, current commit
#   rollback          restore the compose file saved before the last deploy; restart app + worker only
#   seed              database backup, then the idempotent prospects seed (never deletes)
#   deploy <sha>      stdin = tar of the repo's crm/ folder at that commit. Backup, save rollback compose,
#                     build app/worker/tools, run migrations as the owner role, switch app + worker only,
#                     health check, automatic rollback of app + worker if unhealthy.
#
# Never touched: Caddy, DNS, Twenty, n8n, Kien, the legacy portal, secrets, Postgres data beyond
# migrations. Never uses --remove-orphans. Migrations are forward-only: a rollback restores the previous
# app and worker images, not the database; use the pre-deploy dump for a database restore (ask first).
set -euo pipefail

BASE=/opt/portal-new
PROJECT=portal-new
ENVF="$BASE/runtime.env"
NET=portal-new_default
HEALTH=http://127.0.0.1:3021/api/health
LOG=/var/log/portal-new-deploy.log
COMPOSE="$BASE/compose.yml"
PREV="$BASE/compose.rollback-last.yml"

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG" >&2; }
dc() { docker compose -p "$PROJECT" --env-file "$ENVF" -f "$COMPOSE" "$@"; }
healthy() { for _ in $(seq 1 30); do curl -fsS -o /dev/null -m 5 "$HEALTH" && return 0; sleep 3; done; return 1; }
current_tag() { sed -nE 's#^[[:space:]]*image:[[:space:]]*kynetic-portal-app:([0-9a-f]+)[[:space:]]*$#\1#p' "$COMPOSE" | head -1; }

backup() {
  local label="$1" f
  f="/var/backups/portal-new-${label}-$(date -u +%Y%m%dT%H%M%SZ).dump"
  docker exec portal-new-postgres-1 sh -c 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' >"$f"
  [ -s "$f" ] || { log "backup is empty: $f"; rm -f "$f"; exit 1; }
  chmod 600 "$f"
  log "backup ok: $f ($(stat -c %s "$f") bytes)"
}

run_tools() { # $1 = tag, rest = shell command inside the tools image (env from runtime.env, no values printed)
  local tag="$1"; shift
  docker image inspect "kynetic-portal-tools:$tag" >/dev/null 2>&1 || { log "tools image kynetic-portal-tools:$tag missing"; exit 1; }
  docker run --rm --network "$NET" --env-file "$ENVF" --entrypoint sh "kynetic-portal-tools:$tag" -c "$*"
}

cmd="${1:-}"
exec 9>/var/lock/portal-new-deploy.lock
flock -n 9 || { echo "another portal-new-deploy is running" >&2; exit 3; }

case "$cmd" in
  status)
    docker ps --format '{{.Names}} {{.Image}} {{.Status}}' | grep '^portal-new-' || true
    echo "commit: $(cat "$BASE/current-commit" 2>/dev/null || cat "$BASE/src/.commit" 2>/dev/null || echo unknown) tag: $(current_tag)"
    curl -fsS -o /dev/null -m 5 -w 'health=%{http_code}\n' "$HEALTH" || echo "health=down"
    ;;

  rollback)
    [ -s "$PREV" ] || { echo "no saved rollback compose at $PREV" >&2; exit 1; }
    log "rollback: restoring $PREV"
    cp "$COMPOSE" "$BASE/compose.before-rollback.yml"
    cp "$PREV" "$COMPOSE"
    dc up -d --no-deps app worker
    healthy && log "rollback ok, tag $(current_tag)" || { log "rollback: health check FAILED"; exit 1; }
    ;;

  seed)
    tag="$(current_tag)"; [ -n "$tag" ] || { log "cannot read current tag"; exit 1; }
    backup pre-seed
    log "seed: prospects (idempotent, skips existing tenants)"
    run_tools "$tag" 'cd /app && DATABASE_URL_SEED="postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB" bun run db:seed:prospects'
    log "seed done"
    ;;

  deploy)
    sha="${2:-}"; [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { echo "bad sha" >&2; exit 2; }
    tag="${sha:0:7}"
    old="$(current_tag)"; [ -n "$old" ] || { log "cannot read current tag"; exit 1; }
    src="$BASE/src-$tag"
    [ ! -e "$src" ] || { log "$src already exists; refusing to overwrite"; exit 1; }
    log "deploy $sha (tag $tag), previous tag $old"
    tmp="$(mktemp -d "$BASE/.incoming.XXXXXX")"
    trap 'rm -rf "$tmp"' EXIT
    tar -x --no-same-owner --no-same-permissions -C "$tmp"
    [ -f "$tmp/deploy/Dockerfile" ] && [ -f "$tmp/package.json" ] || { log "tar is not a crm/ tree"; exit 1; }
    mv "$tmp" "$src"; trap - EXIT
    echo "$sha" >"$src/.commit"

    backup "pre-deploy-$tag"
    cp "$COMPOSE" "$PREV"
    cp "$COMPOSE" "$BASE/compose.rollback-$old.yml"

    for target in app worker tools; do
      log "build $target"
      docker build -q -f "$src/deploy/Dockerfile" --target "$target" -t "kynetic-portal-$target:$tag" "$src" >/dev/null
    done

    log "migrate (owner role)"
    run_tools "$tag" 'bun run db:migrate' >>"$LOG" 2>&1 || { log "migration FAILED; app and worker untouched"; exit 1; }

    log "switch app + worker to $tag"
    sed -i -E "s#(image:[[:space:]]*kynetic-portal-(app|worker):)[0-9a-f]+#\1$tag#" "$COMPOSE"
    dc up -d --no-deps app worker
    if healthy; then
      echo "$sha" >"$BASE/current-commit"
      log "deploy ok: $tag"
    else
      log "health check FAILED; rolling back app + worker to $old"
      cp "$PREV" "$COMPOSE"
      dc up -d --no-deps app worker
      healthy && log "rolled back to $old" || log "rollback health check ALSO failed; investigate"
      exit 1
    fi
    ;;

  *)
    echo "usage: status | rollback | seed | deploy <sha>" >&2
    exit 2
    ;;
esac
