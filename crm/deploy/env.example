# Names only; set real values in the environment's own .env (mode 600, outside the repo). Never commit values.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
APP_BASE_URL=
DATABASE_URL=
# kynetic_auth role: Better-Auth only (global auth tables and the sign-in gate)
DATABASE_URL_AUTH=
DATABASE_URL_WORKER=
DATABASE_URL_BACKUP=
# Google sign-in; set both or neither
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
APP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
OUTBOUND_ENABLED=false
PROVIDER_MODE=live
# Off unless a person turns them on. They do not enable calls or texts.
ADMIN_ALERT_EMAIL_ENABLED=false
CLIENT_EMAIL_ENABLED=false
# Real ElevenLabs calls remain off until separately authorized and explicitly enabled.
ELEVENLABS_LIVE_ENABLED=false
