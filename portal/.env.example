# Runtime DB role (RLS-bound, not table owner)
DATABASE_URL=postgres://portal_app:CHANGE_ME@portal-db:5432/portal
# Owner role, used only by migrations/seed/create-admin
DATABASE_OWNER_URL=postgres://portal_owner:CHANGE_ME@portal-db:5432/portal
APP_URL=https://portal.kyneticai.com
AUTH_URL=https://portal.kyneticai.com
AUTH_SECRET=            # openssl rand -base64 32
ENCRYPTION_KEY=         # openssl rand -base64 32  (AES-256-GCM key for TOTP secrets)
FILE_SIGNING_SECRET=    # openssl rand -hex 32
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25
# Google sign-in (optional). Both must be set to turn it on. Invite-only: only emails an admin has already added can use it.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email — until set, emails are logged to the server console
RESEND_API_KEY=
EMAIL_FROM=Kynetic AI <portal@kyneticai.com>
# Cloudflare R2 — until all four are set, files use local disk (UPLOAD_DIR)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
