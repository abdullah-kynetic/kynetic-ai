    {
      "id": "bafb86ec-53a9-4fa6-b0a1-45f54a14ead0",
      "name": "Code1",
      "parameters": {
        "jsCode": "const allInputs = $input.all().map(i => i.json);\n\n// 1. Baseline docket (from Edit Fields1)\nconst agendaInput = allInputs.find(i => i.cleaned_agenda_only_docket);\n\n// 2. Extracted attachment texts (from Edit Fields2)\nconst extractedAttachments = allInputs.filter(i =>\n  i.text !== undefined &&\n  i.item_number !== undefined &&\n  i.attachments?.title !== undefined\n);\n\n// 3. Build lookup: key = \"item_number||title\"\nconst attachmentMap = new Map();\nextractedAttachments.forEach(item => {\n  const key = `${item.item_number}||${item.attachments.title}`;\n  attachmentMap.set(key, {\n    title: item.attachments.title,\n    link: item.attachments.link,\n    text: item.text\n  });\n});\n\n// 4. Enrich baseline docket\nconst caseItems = (agendaInput?.cleaned_agenda_only_docket || []).map(item => {\n  const enrichedAttachments = (item.attachments || []).map(attach => {\n    const key = `${item.item_number}||${attach.title}`;\n    const extracted = attachmentMap.get(key);\n    return extracted \n      ? { ...attach, text: extracted.text } \n      : { ...attach, text: null };\n  });\n\n  return {\n    item_number: item.item_number,\n    raw_text: item.raw_text,\n    attachments: enrichedAttachments\n  };\n});\n\n// 5. Output for AI Agent\nreturn [{\n  json: {\n    full_agenda_text: agendaInput?.full_agenda_text || \"\",\n    case_items: caseItems\n  }\n}];"
      },
      "position": [
        -224,
        96
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
