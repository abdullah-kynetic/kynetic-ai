        "assignments": {
          "assignments": [
            {
              "id": "email-to",
              "name": "emailTo",
              "type": "string",
              "value": "={{ $json.body?.to ?? \"\" }}"
            },
            {
              "id": "email-subject",
              "name": "emailSubject",
              "type": "string",
              "value": "={{ $json.body?.subject ?? \"(no subject)\" }}"
            },
            {
              "id": "email-message",
              "name": "emailMessage",
              "type": "string",
              "value": "={{ $json.body?.html ?? $json.body?.text ?? \"\" }}"
            },
            {
              "id": "sender-name",
              "name": "senderName",
              "type": "string",
              "value": "={{ $json.body?.from ?? \"Kynetic AI\" }}"
            }
          ]
        },
        "includeOtherFields": false,
        "mode": "manual"
      },
      "position": [
        224,
        96
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5
    },
    {
