        "message": "={{ $json.emailMessage }}",
        "operation": "send",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $json.senderName }}"
        },
        "resource": "message",
        "sendTo": "={{ $json.emailTo }}",
        "subject": "={{ $json.emailSubject }}"
      },
      "position": [
        448,
        96
      ],
      "type": "n8n-nodes-base.gmail",
