      "name": "Map Stylist to Event Type",
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst map = { Sarah: 5899666, Marcus: 5899667, Jessica: 5899668 };\nconst eventTypeId = map[b.stylist] || 5899666;\nreturn [{ json: { eventTypeId, start: b.start_time, stylist: b.stylist, service: b.service_type, attendee: { name: b.name, email: b.email || 'placeholder@example.com', timeZone: 'America/New_York', phoneNumber: b.phone_number } } }];"
