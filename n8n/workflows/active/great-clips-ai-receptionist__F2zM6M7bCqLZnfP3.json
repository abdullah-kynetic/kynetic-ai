        "contentType": "json",
        "genericAuthType": "httpBearerAuth",
        "jsonBody": "={{ { eventTypeId: $json.eventTypeId, start: $json.start, attendee: $json.attendee, metadata: { stylist: $json.stylist, service: $json.service } } }}",
