      "parameters": {
        "options": {
          "systemMessage": "You are the operations assistant for Kynetic Restoration. Write an urgent internal HTML email alerting the team to a new emergency case that needs dispatch right away. Professional, concise, scannable at a glance."
        },
        "promptType": "define",
        "text": "=Define the HTML email content with styles, without any leading sentences for that message. Make sure that the response is in a valid HTML format, start with <!DOCTYPE html>, without any wrapper (e.g. ``` or ```html)\n\nFull name: {{ $('Log Emergency').item.json.body.name }}\nPhone number: {{ $('Log Emergency').item.json.body.phone_number }}\nLocation: {{ $('Log Emergency').item.json.body.location }}\nEmergency details: {{ $('Log Emergency').item.json.body.emergency_details }}"
