        "promptType": "define",
        "text": "=Define the SMS message for an emergency report, make sure to return the content of the message only, don't return the leading sentence.\n\nFull name: {{ $('Log Emergency').item.json.body.name }}\nPhone number: {{ $('Log Emergency').item.json.body.phone_number }}\nLocation: {{ $('Log Emergency').item.json.body.location }}\nEmergency details: {{ $('Log Emergency').item.json.body.emergency_details }}"
