      "id": "350e2ad6-6e48-47a1-a061-d2a03ea094f8",
      "name": "AI Agent",
      "parameters": {
        "options": {
          "systemMessage": "You are the operations assistant for Kynetic Restoration, a water damage restoration company in Austin, Texas. Write a clear, professional internal notification email to the team about a new inbound inquiry that the AI receptionist could not fully resolve. This is internal, never customer-facing. Factual and concise. Include a short 'Recommended next step' line."
        },
        "promptType": "define",
        "text": "=Define the wrap-up HTML email content with styles, without any leading sentences. Make sure that the response is in a valid HTML format, start with <!DOCTYPE html>, without any wrapper (e.g. ``` or ```html).\n\nFull name: {{ $('Log Inquiry').item.json.body.name }}\nPhone number: {{ $('Log Inquiry').item.json.body.phone_number }}\nLocation: {{ $('Log Inquiry').item.json.body.location }}\nInquiry: {{ $('Log Inquiry').item.json.body.inquiry_details }}"
      },
      "position": [
        816,
        1216
      ],
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2
    },
    {
      "id": "51ac6610-40e7-491c-a4b7-432df35bbed3",
      "name": "AI Agent1",
      "parameters": {
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the AI receptionist for Kynetic Restoration, a water damage restoration company in Austin, Texas. Write a warm, professional SMS confirming the customer's on-site assessment appointment. Keep it under 320 characters. Mention the service and the booked time. No emojis. Do not include a greeting line or sign-off beyond the company name."
        },
        "promptType": "define",
        "text": "=Define the SMS message to wrap up the appointment, make sure to return the content of the message only, don't return the leading sentence.\n\nFull name: {{ $('Job Creation').item.json.body.name }}\nPhone number: {{ $('Job Creation').item.json.body.phone_number }}\nLocation: {{ $('Job Creation').item.json.body.location }}\nBooked time: {{ $('Job Creation').item.json.body.preferred_time }}\nService type: {{ $('Job Creation').item.json.body.service_type }}\nAppointment booked? or booked link: {{ $('Job Creation').item.json.body.appointment_booked }}"
      },
      "position": [
        1040,
        576
      ],
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2
    },
