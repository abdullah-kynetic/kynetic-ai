      "name": "Draft Canned Response",
      "parameters": {
        "jsCode": "const rating = $('Review Response Webhook').first().json.body.rating || 0;\nconst client = $('Client Config Lookup (RV)').first().json;\nlet draft;\nif (rating >= 4) {\n  draft = `Thank you so much for the kind words! We're thrilled you had a great experience with ${client.client_name}. ${client.voice_agent_name} and the team appreciate it!`;\n} else {\n  draft = `Thank you for your feedback. We're sorry your experience with ${client.client_name} didn't meet expectations — please reach out so we can make it right.`;\n}\nreturn [{ json: { draft_response: draft, rating, is_positive: rating >= 4 } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        448,
        416
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
