    {
      "id": "node-audience-router",
      "name": "Audience Router",
      "parameters": {
        "mode": "rules",
        "options": {
          "allMatchingOutputs": false,
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unknown"
        },
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.phone_number_id }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "DIRECTOR_GROUP_PHONE_NUMBER_ID"
                  }
                ],
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                }
              },
              "outputKey": "director",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.phone_number_id }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "VOLUNTEER_GROUP_PHONE_NUMBER_ID"
                  }
                ],
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                }
              },
              "outputKey": "volunteer",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.sender_phone }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "ADMIN_PHONE_NUMBER"
                  }
                ],
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                }
              },
              "outputKey": "admin",
