    },
    {
      "id": "node-tool-log-attendance",
      "name": "Tool — Log Attendance",
      "parameters": {
        "databaseId": {
          "__rl": true,
          "mode": "id",
          "value": "PROGRAM_LOG_DB2_ID_HERE"
        },
        "description": "Use this to log attendance when a director reports a session. Extract: program_name, attendance_count (number), satellite location, and any notes or incidents.",
        "operation": "create",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Attendance|number",
              "numberValue": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('attendance_count', 'Number of attendees present', 'number') }}",
              "type": "number"
            },
            {
              "key": "Satellite|select",
              "selectValue": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('satellite', 'Which satellite location', 'string') }}",
              "type": "select"
            },
            {
              "key": "Director Phone|phone_number",
              "phoneValue": "={{ $json.sender_phone }}",
              "type": "phone_number"
            },
            {
              "key": "Notes|rich_text",
              "richText": false,
              "textContent": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('notes', 'Any additional notes or incidents from the session', 'string') }}",
              "type": "rich_text"
            }
          ]
        },
        "resource": "databasePage",
        "simple": true,
        "title": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('program_name', 'The name of the program or session', 'string') }}"
      },
      "position": [
