    {
      "id": "2c44d676-9eea-4694-9b05-7fd2e6b7054a",
      "name": "Prepare Emails",
      "parameters": {
        "jsCode": "const byName = {};\nfor (const l of $('Get Gmail Labels').all()) { byName[l.json.name] = l.json.id; }\nconst labelMap = {\n  urgent: byName['AI/Urgent'],\n  client_request: byName['AI/Client'],\n  sales_lead: byName['AI/Lead'],\n  promotion: byName['AI/Promotion'],\n  fyi: byName['AI/FYI'],\n  cold_pitch: byName['AI/Cold Pitch'],\n  triaged: byName['AI/Triaged']\n};\nreturn $('Gmail Trigger').all().map((e, i) => {\n  const sender = (e.json.from && e.json.from.value && e.json.from.value[0]) || {};\n  const body = (e.json.text || e.json.snippet || '').toString().slice(0, 6000);\n  return {\n    json: {\n      messageId: e.json.id,\n      threadId: e.json.threadId,\n      fromEmail: sender.address || '',\n      fromName: sender.name || sender.address || 'Unknown sender',\n      subject: e.json.subject || '(no subject)',\n      body: body,\n      receivedAt: e.json.date || '',\n      labelMap: labelMap\n    },\n    pairedItem: { item: i }\n  };\n});",
        "mode": "runOnceForAllItems"
      },
      "position": [
        280,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "631570b2-c086-47ec-882a-4817be0f416a",
      "name": "AI Triage",
      "parameters": {
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You triage the inbox for James Carter, founder of Brightline Media, a small performance marketing agency that runs Google and Meta ads for local businesses.\n\nPick exactly one category:\n- urgent: a client or partner reports something broken, money at risk, a deadline today, or an angry client. Needs James personally.\n- client_request: an existing client asks a question or requests work, but nothing is on fire.\n- sales_lead: a prospective client asks about services, pricing, or a call.\n- promotion: a vendor or partner offer, discount, or event invite James might care about.\n- fyi: receipts, notifications, newsletters, internal updates. No reply needed.\n- cold_pitch: unsolicited sales pitches, link building, offshore dev offers, spam.\n\nRules:\n- urgent_summary: only for urgent. Two short sentences: what happened and what James should do. Plain text, no symbols like < or &.\n- draft_reply: only for client_request, sales_lead, and promotion. Write a short, warm reply from James in plain text, under 120 words, no subject line. Never promise pricing, dates, or refunds. For sales leads, suggest a quick call and ask for two times that work.\n- For fyi, cold_pitch, and urgent, leave draft_reply as an empty string.\n- reasoning: one sentence on why you chose the category.\n\nExamples:\n\"Our conversion tracking stopped working, we cannot see results\" -> urgent\n\"Can you add a new ad set for our fall promo?\" -> client_request\n\"Saw your site, what would ads cost for my dental office?\" -> sales_lead\n\"30% off our reporting software this week\" -> promotion\n\"Your Stripe receipt\" -> fyi\n\"We build backlinks, DA 50+\" -> cold_pitch",
              "type": "SystemMessagePromptTemplate"
            }
          ]
        },
        "promptType": "define",
        "text": "=From: {{ $json.fromName }} <{{ $json.fromEmail }}>\nSubject: {{ $json.subject }}\n\nBody:\n{{ $json.body }}"
      },
      "position": [
        520,
        0
      ],
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9
    },
