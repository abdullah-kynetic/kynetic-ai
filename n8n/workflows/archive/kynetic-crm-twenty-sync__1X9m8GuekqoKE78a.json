    {
      "id": "796fdeee-295f-484c-bd31-d42d28567ed5",
      "name": "Match Existing Contact",
      "parameters": {
        "jsCode": "const item = $json;\nconst existing = $('Get All End Customers').all().find(e => e.json.seldonframeContactId === item.id);\nreturn {\n  seldonframeContactId: item.id,\n  firstName: item.firstName || '',\n  lastName: item.lastName || '',\n  phone: item.phone || '',\n  email: item.email || '',\n  status: item.status || '',\n  source: item.source || '',\n  id: existing ? existing.json.id : '',\n  matched: !!existing\n};",
        "mode": "runOnceForEachItem"
      },
      "position": [
        900,
        96
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "c980e21b-ed2a-48c1-99c6-11c3e288816b",
      "name": "Match Contact & Existing Booking",
      "parameters": {
        "jsCode": "const item = $json;\nconst contact = $('Get All End Customers').all().find(e => e.json.seldonframeContactId === item.contactId);\nconst existingJob = $('Get All Client Jobs').all().find(j => j.json.seldonframeBookingId === item.id);\nconst statusMap = { confirmed: 'SCHEDULED', booked: 'SCHEDULED', pending: 'SCHEDULED', in_progress: 'IN_PROGRESS', completed: 'COMPLETED', done: 'COMPLETED', cancelled: 'CANCELED', canceled: 'CANCELED' };\nconst rawStatus = (item.status || '').toString().toLowerCase();\nreturn {\n  seldonframeBookingId: item.id,\n  title: item.title || '',\n  status: statusMap[rawStatus] || 'SCHEDULED',\n  meetingUrl: item.meetingUrl || '',\n  startsAt: item.startsAt || '',\n  contactRecordId: contact ? contact.json.id : '',\n  id: existingJob ? existingJob.json.id : '',\n  matched: !!existingJob\n};",
        "mode": "runOnceForEachItem"
      },
      "position": [
        900,
        384
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
