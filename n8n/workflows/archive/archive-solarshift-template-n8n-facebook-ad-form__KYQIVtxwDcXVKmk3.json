      "id": "e23b3229-664d-43d5-898e-e421209a75e4",
      "name": "Format Phone Number",
      "parameters": {
        "jsCode": "// n8n Code Node: Format phone numbers into +1XXXXXXXXXX\nconst inputNumber = $json.phone || $json.phoneNumber || $json.number || \"\";\nlet digits = inputNumber.replace(/\\D/g, \"\");\nif (digits.length === 10) {\n  digits = \"1\" + digits;\n} else if (digits.length > 11) {\n  digits = digits.slice(-11);\n} else if (digits.length < 10) {\n  throw new Error(`Invalid phone number: ${inputNumber}`);\n}\nconst formattedNumber = `+${digits}`;\nreturn [{\n  formattedPhone: formattedNumber,\n  originalInput: inputNumber,\n}];"
      },
