    {
      "id": "f6bec915-e247-4808-bf7e-70a0c1698912",
      "name": "Parse Approval",
      "parameters": {
        "jsCode": "const text = $json.message?.text || '';\nconst chatId = $json.message?.from?.id;\nconst m = text.match(/^(APPROVE|REJECT)-EXP-(\\d+)/i);\nreturn [{ json: {\n  isAdmin: chatId == REDACTED_TELEGRAM_CHAT_ID,\n  action: m ? m[1].toUpperCase() : null,\n  expenseNumber: m ? parseInt(m[2], 10) : null,\n  adminChatId: chatId\n} }];",
        "mode": "runOnceForAllItems"
      },
      "position": [
        240,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "7976376d-89e7-4216-b155-ac18c7cbf51e",
      "name": "Valid Admin Approval?",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.isAdmin }}",
              "operator": {
                "operation": "equals",
                "type": "boolean"
              },
              "rightValue": true
            },
            {
              "leftValue": "={{ $json.action }}",
              "operator": {
                "operation": "isNotEmpty",
                "type": "string"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          }
        }
      },
      "position": [
        460,
