    {
      "id": "48e1c9ac-0a7c-42fb-b664-f3f525da3640",
      "name": "Match Expense Code",
      "parameters": {
        "jsCode": "const targetNumber = $('Parse Approval').first().json.expenseNumber;\nconst match = $input.all().find(item => item.json.properties?.['Expense Code']?.unique_id?.number === targetNumber);\nif (!match) {\n  return [{ json: { found: false } }];\n}\nconst directorRelation = match.json.properties.Director?.relation;\nconst descriptionTitle = match.json.properties.Description?.title;\nreturn [{ json: {\n  found: true,\n  pageId: match.json.id,\n  directorId: (directorRelation && directorRelation[0]) ? directorRelation[0].id : null,\n  amount: match.json.properties.Amount?.number,\n  description: (descriptionTitle && descriptionTitle[0]) ? descriptionTitle[0].plain_text : ''\n} }];",
        "mode": "runOnceForAllItems"
      },
      "position": [
        900,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
