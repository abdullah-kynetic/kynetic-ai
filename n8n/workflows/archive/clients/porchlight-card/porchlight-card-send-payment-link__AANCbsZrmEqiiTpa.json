    {
      "id": "77ac9310-1236-40f4-9d92-a0d43be45634",
      "name": "Match Business",
      "parameters": {
        "jsCode": "const inp = $('Normalize Entry').first().json;\nconst rows = $input.all().map(function (i) { return i.json; });\nconst norm = function (s) { return String(s || '').toLowerCase().replace(/[^a-z0-9]/g, ''); };\nlet match = null;\nfor (const r of rows) { if (norm(r.name) === inp.nameKey) { match = r; break; } }\nif (!match) for (const r of rows) {\n  const n = norm(r.name);\n  if (n && n.length >= 5 && inp.nameKey.length >= 5 && (n.indexOf(inp.nameKey) >= 0 || inp.nameKey.indexOf(n) >= 0)) { match = r; break; }\n}\nconst prior = match ? String(match.property_call_notes || '') : '';\nconst line = inp.today + ': link sent to ' + inp.email + ' for ' + inp.category + (inp.notes ? '. ' + inp.notes : '');\nconst notes = (prior ? prior + '\\n' : '') + line;\nconst props = {\n  'Sale Stage': { select: { name: 'Link sent' } },\n  'Customer Email': { email: inp.email || null },\n  'Last Call Date': { date: { start: inp.today } },\n  'Call Notes': { rich_text: [{ text: { content: notes.slice(-1900) } }] }\n};\nconst createProps = Object.assign({}, props, { 'Business Name': { title: [{ text: { content: inp.businessName } }] } });\nreturn [{ json: {\n  found: !!match,\n  pageId: match ? match.id : '',\n  updateBody: { properties: props },\n  createBody: { parent: { database_id: '5db44cc8-35d1-451e-bb69-2cd2ab6ffc3e' }, properties: createProps }\n} }];",
        "mode": "runOnceForAllItems"
      },
      "position": [
        660,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
