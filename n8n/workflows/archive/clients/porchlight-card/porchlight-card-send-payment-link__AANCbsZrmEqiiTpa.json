      "name": "Normalize Entry",
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst businessName = String(j['Business name'] || '').trim();\nreturn [{ json: {\n  businessName: businessName,\n  nameKey: businessName.toLowerCase().replace(/[^a-z0-9]/g, ''),\n  firstName: String(j['Owner first name'] || '').trim() || 'there',\n  email: String(j['Owner email'] || '').trim().toLowerCase(),\n  category: String(j['Category they are claiming'] || '').trim(),\n  notes: String(j['Call notes'] || '').trim(),\n  today: new Date().toISOString().slice(0, 10)\n} }];",
        "mode": "runOnceForAllItems"
      },
      "position": [
        220,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
