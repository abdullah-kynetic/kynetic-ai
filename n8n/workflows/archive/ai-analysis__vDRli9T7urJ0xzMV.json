    {
      "id": "0e9d81f7-f2c2-485f-85e3-b2065d937785",
      "name": "Code1",
      "parameters": {
        "jsCode": "// Get all inputs\nconst allInputs = $input.all().map(i => i.json);\n\nconsole.log('=== DIAGNOSTIC START ===');\nconsole.log('Total inputs:', allInputs.length);\n\n// Check what we received\nallInputs.forEach((input, idx) => {\n  console.log(`\\nInput ${idx}:`, {\n    hasCleanedDocket: !!input.cleaned_agenda_only_docket,\n    hasFullText: !!input.full_agenda_text,\n    hasText: !!input.text,\n    hasItemNumber: !!input.item_number,\n    hasTitle: !!input.title,\n    titleType: typeof input.title,\n    sampleKeys: Object.keys(input).slice(0, 5)\n  });\n  \n  // Show first attachment example\n  if (input.title && idx === 1) {\n    console.log('Sample title structure:', JSON.stringify(input.title, null, 2));\n  }\n});\n\n// Find baseline\nconst agendaInput = allInputs.find(i => i.cleaned_agenda_only_docket !== undefined);\nconsole.log('\\n=== BASELINE ===');\nconsole.log('Found baseline:', !!agendaInput);\nconsole.log('Docket items:', agendaInput?.cleaned_agenda_only_docket?.length);\n\n// Find attachments\nconst attachInputs = allInputs.filter(i => \n  i.text !== undefined && \n  i.item_number !== undefined && \n  i.title !== undefined\n);\nconsole.log('\\n=== ATTACHMENTS ===');\nconsole.log('Attachment items found:', attachInputs.length);\n\n// Show first 3 keys that would be created\nattachInputs.slice(0, 3).forEach(item => {\n  const titleString = item.title?.title || item.title;\n  const key = `${item.item_number}:${titleString}`;\n  console.log('Sample key:', key);\n});\n\nconsole.log('=== DIAGNOSTIC END ===');\n\n// Return empty for now\nreturn [{ json: { diagnostic: 'complete' } }];"
      },
