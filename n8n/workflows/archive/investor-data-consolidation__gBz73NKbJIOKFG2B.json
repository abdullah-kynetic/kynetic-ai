    {
      "id": "c29db983-49a4-474a-bd40-71f4e04c8254",
      "name": "Consolidate and Flag Records",
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\nconst groups = {};\nfor (const row of rows) {\n  const acct = (row['Account Number'] || '').toString().trim();\n  if (!groups[acct]) groups[acct] = [];\n  groups[acct].push(row);\n}\nconst output = [];\nfor (const acct in groups) {\n  const group = groups[acct];\n  const names = [...new Set(group.map(r => (r['Investor Name'] || '').toString().trim()).filter(n => n !== ''))];\n  const amounts = [...new Set(group.map(r => (r['Investment Amount'] === '' || r['Investment Amount'] === undefined || r['Investment Amount'] === null) ? null : Number(r['Investment Amount'])))];\n  const types = [...new Set(group.map(r => (r['Transaction Type'] || '').toString().trim()))];\n  const dates = [...new Set(group.map(r => (r['Closing Date'] || '').toString().trim()))];\n  const hasMissingName = names.length === 0;\n  const hasMissingAmount = amounts.includes(null);\n  const validAmounts = amounts.filter(a => a !== null);\n  const amountMismatch = validAmounts.length > 1;\n  let status = 'OK';\n  const notes = [];\n  if (hasMissingName) { status = 'MISSING DATA'; notes.push('Investor name missing in all source records'); }\n  if (hasMissingAmount) { status = 'MISSING DATA'; notes.push('Investment amount missing in at least one source record'); }\n  if (amountMismatch) { status = 'MISMATCH'; notes.push('Investment amount differs across sources: ' + validAmounts.join(' vs ')); }\n  if (group.length > 1 && !amountMismatch && !hasMissingAmount && !hasMissingName) { notes.push('Reported in ' + group.length + ' source files, values match'); }\n  output.push({ json: {\n    'Account Number': acct,\n    'Investor Name': names[0] || '',\n    'Investment Amount': validAmounts.length ? validAmounts[0] : '',\n    'Transaction Type': types[0] || '',\n    'Closing Date': dates[0] || '',\n    'Source Count': group.length,\n    'Status': status,\n    'Notes': notes.join('; ')\n  } });\n}\nreturn output;",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        896,
        192
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
