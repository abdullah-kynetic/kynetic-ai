    {
      "id": "ba7c3e3d-891c-4ba6-9f5f-a1a24628e302",
      "name": "Human in the Loop",
      "parameters": {
        "message": "=Hey Michele, we have a new lead and below you can find the email we drafted for this lead to send through:\n\n<h2>PROJECT DESCRIPTION</h2>\n{{ $('On form submission').item.json['Project Description'] }}\n\n\n<h2>EMAIL DRAFTED</h2>\n\n{{ $json.email_body }}\n\n\nPlease provide any feedback if you have",
        "operation": "sendAndWait",
        "options": {
          "appendAttribution": false
        },
        "responseType": "freeText",
        "sendTo": "michele.torti5@gmail.com",
        "subject": "=ACTION REQUIRED: New Lead with Budget of {{ $('On form submission').item.json.Budget }}"
      },
      "position": [
        448,
        320
      ],
      "type": "n8n-nodes-base.gmail",
