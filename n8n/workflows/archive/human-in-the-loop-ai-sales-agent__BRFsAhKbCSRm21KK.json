    {
      "id": "888dba46-bf87-42f2-88f9-748168a0c42c",
      "name": "Text Classifier",
      "parameters": {
        "categories": {
          "categories": [
            {
              "category": "approved",
              "description": "The sales agent approved the email and accepted the way it was written. The text that we are classifying intents that it was accepted and that everything was good\n\n\nExample Output:\n\n\"yes\"\n\"that's fine\"\n\"looks good\"\n\"send it through\""
            },
            {
              "category": "denied",
              "description": "The sales agent denied the email and denied the way it was written. The text that we are classifying intents that it needs updating or changing (usuaally provided with feedback on how to do so)\n\nExample Output:\n\n\"Make it shorter\"\n\"I don't like it\"\n\"it's too long\"\n\"Include another project\"\n\"no\"\n"
            }
          ]
        },
        "inputText": "={{ $json.data.text }}",
        "options": {}
      },
      "position": [
        624,
        320
      ],
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1.1
