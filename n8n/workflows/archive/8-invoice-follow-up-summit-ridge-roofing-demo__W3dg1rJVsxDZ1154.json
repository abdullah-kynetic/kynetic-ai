    {
      "id": "80ce4291-090b-437f-a562-66973054999d",
      "name": "Pick Reminder Stage",
      "parameters": {
        "jsCode": "const STAGES = [7, 14, 21, 28, 35, 42];\nconst BUSINESS = 'Summit Ridge Roofing';\nconst money = n => '$' + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n\nfunction build(stage, r, dueText) {\n  const name = r.first_name || 'there';\n  const inv = r.invoice_number;\n  const amt = money(r.amount_due);\n  const link = r.payment_link ? '<p><a href=\"' + r.payment_link + '\">Pay invoice ' + inv + ' online</a></p>' : '';\n  const sign = '<p>Thank you,<br>Accounts Team<br>' + BUSINESS + '</p>';\n  const t = {\n    7: ['Quick check in on invoice ' + inv,\n        '<p>Hi ' + name + ',</p><p>Hope you are doing well. Just checking in on invoice ' + inv + ' for ' + amt + ', which was due on ' + dueText + '. If payment is already on its way, please ignore this note.</p>'],\n    14: ['Reminder: invoice ' + inv + ' is 2 weeks past due',\n        '<p>Hi ' + name + ',</p><p>A friendly reminder that invoice ' + inv + ' for ' + amt + ' was due on ' + dueText + ' and is now two weeks past due. Let us know if you have any questions about it.</p>'],\n    21: ['Invoice ' + inv + ' is 3 weeks past due',\n        '<p>Hi ' + name + ',</p><p>Invoice ' + inv + ' for ' + amt + ' is now three weeks past due. If something about the work or the invoice needs attention, reply to this email and we will sort it out right away.</p>'],\n    28: ['Can you confirm a payment date for invoice ' + inv + '?',\n        '<p>Hi ' + name + ',</p><p>We still show ' + amt + ' open on invoice ' + inv + ', due ' + dueText + '. Could you reply with the date we should expect payment?</p>'],\n    35: ['Second notice: invoice ' + inv + ' is 5 weeks past due',\n        '<p>Hi ' + name + ',</p><p>Invoice ' + inv + ' for ' + amt + ' is now five weeks past due. Under our payment terms, new scheduled work may be paused until the account is current. We would like to avoid that, so please send payment or reply with a date.</p>'],\n    42: ['Final notice: invoice ' + inv,\n        '<p>Hi ' + name + ',</p><p>This is our final automated notice for invoice ' + inv + ' (' + amt + '), originally due ' + dueText + '. Our owner will call you within two business days to resolve the balance.</p>']\n  }[stage];\n  return { subject: t[0], html: t[1] + link + sign };\n}\n\nconst out = [];\n$input.all().forEach((item, i) => {\n  const r = item.json;\n  if (!r.due_date || r.status === 'paid') return;\n  const due = DateTime.fromISO(String(r.due_date)).startOf('day');\n  const daysOverdue = Math.floor($today.diff(due, 'days').days);\n  const reached = STAGES.filter(s => daysOverdue >= s);\n  if (reached.length === 0) return;\n  const stage = reached[reached.length - 1];\n  if (stage <= Number(r.last_reminder_stage || 0)) return;\n  const msg = build(stage, r, due.toFormat('MMMM d, yyyy'));\n  out.push({\n    json: {\n      rowId: r.id,\n      invoice_number: r.invoice_number,\n      company: r.company,\n      email: r.email,\n      daysOverdue: daysOverdue,\n      stage: stage,\n      newStatus: stage >= 42 ? 'needs_call' : 'overdue',\n      subject: msg.subject,\n      html: msg.html\n    },\n    pairedItem: { item: i }\n  });\n});\nreturn out;",
        "mode": "runOnceForAllItems"
      },
      "position": [
        240,
        80
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
