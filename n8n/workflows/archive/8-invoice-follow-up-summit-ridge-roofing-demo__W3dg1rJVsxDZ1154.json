      "id": "20944746-d81d-40c3-814b-e60424213479",
      "name": "Extract Payment Details",
      "parameters": {
        "jsCode": "const j = $json;\nlet invoiceRef = '';\nlet email = '';\nlet amount = null;\nlet source = 'manual form';\nif (j['Invoice Number']) {\n  invoiceRef = String(j['Invoice Number']).trim().toUpperCase();\n} else {\n  const obj = (j.data && j.data.object) || {};\n  source = 'stripe ' + (j.type || '');\n  invoiceRef = String((obj.metadata && obj.metadata.invoice_number) || obj.client_reference_id || '').trim().toUpperCase();\n  email = String(obj.customer_email || (obj.customer_details && obj.customer_details.email) || obj.receipt_email || '').trim().toLowerCase();\n  amount = Number(obj.amount_paid || obj.amount_total || obj.amount_received || 0) / 100;\n}\nreturn { json: { invoiceRef: invoiceRef, email: email, amount: amount, source: source, paidDate: $today.toISODate() } };",
        "mode": "runOnceForEachItem"
      },
      "position": [
        0,
        600
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
