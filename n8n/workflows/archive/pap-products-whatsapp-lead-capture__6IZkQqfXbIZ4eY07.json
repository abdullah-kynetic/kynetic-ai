      "name": "Normalize WhatsApp Lead",
      "parameters": {
        "jsCode": "let parsed = {};\ntry { parsed = JSON.parse($('Parse WA with Claude').item.json.choices[0].message.content || '{}'); } catch(e) {}\nconst raw = $('Extract WhatsApp Message').item.json;\nreturn {\n  source: 'WhatsApp',\n  phone: raw.from_phone || '',\n  business_name: parsed.business_name || raw.profile_name || '',\n  contact_name: parsed.contact_name || raw.profile_name || '',\n  products_needed: parsed.products_needed || '',\n  quantity: parsed.quantity || '',\n  urgency: parsed.urgency || 'Unknown',\n  raw_content: (raw.message_body || '').slice(0, 2000),\n  reply_to_phone: raw.from_phone || ''\n};",
        "mode": "runOnceForEachItem"
      },
