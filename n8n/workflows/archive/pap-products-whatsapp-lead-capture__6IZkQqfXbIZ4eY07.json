      "name": "Format Lead Card",
      "parameters": {
        "jsCode": "let lead = {};\ntry { lead = $('Restore Lead Data After Create').item.json; } catch(e) {}\nif (!lead.phone) { try { lead = $('Returning Customer (no action)').item.json; } catch(e) {} }\n\nconst notionUrl = $input.item.json.url || '';\nconst returning = lead.is_returning ? '🔁 Returning customer' : '🆕 New customer';\nconst card = [\n  '🔔 New Lead — Pap Products',\n  'Source: ' + (lead.source || ''),\n  'Business: ' + (lead.business_name || ''),\n  'Contact: ' + (lead.contact_name || '') + ' · ' + (lead.phone || ''),\n  'Needs: ' + (lead.products_needed || ''),\n  'Qty: ' + (lead.quantity || ''),\n  'Urgency: ' + (lead.urgency || ''),\n  returning,\n  notionUrl ? 'Notion: ' + notionUrl : ''\n].filter(Boolean).join('\\n');\n\nreturn { ...lead, lead_card_text: card, notion_url: notionUrl };",
        "mode": "runOnceForEachItem"
      },
