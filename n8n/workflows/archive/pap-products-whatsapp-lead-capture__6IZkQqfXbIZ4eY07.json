      "parameters": {
        "authentication": "predefinedCredentialType",
        "jsonBody": "={ \"model\": \"anthropic/claude-sonnet-4-6\", \"messages\": [{ \"role\": \"system\", \"content\": \"Extract order info from this WhatsApp message. Return ONLY a JSON object with fields: business_name (string), contact_name (string), products_needed (string), quantity (string), urgency (one of: ASAP, This week, Just browsing). Use empty string for unknown fields.\" }, { \"role\": \"user\", \"content\": \"Sender name: {{ $json.profile_name }}\\nMessage: {{ $json.message_body }}\" }], \"response_format\": { \"type\": \"json_object\" } }",
        "method": "POST",
        "nodeCredentialType": "openRouterApi",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "url": "https://openrouter.ai/api/v1/chat/completions"
      },
