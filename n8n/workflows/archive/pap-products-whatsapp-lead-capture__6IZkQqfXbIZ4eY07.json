      "id": "8ab83ea2-164d-4b31-b7b3-579b8e4b7f39",
      "name": "Extract WhatsApp Message",
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nif (body['hub.challenge']) return { skip: true, challenge: String(body['hub.challenge']) };\ntry {\n  const val = body.entry?.[0]?.changes?.[0]?.value;\n  const msg = val?.messages?.[0];\n  if (!msg || val?.statuses) return { skip: true, challenge: '' };\n  return {\n    skip: false,\n    challenge: '',\n    from_phone: (msg.from || '').replace(/\\D/g,''),\n    profile_name: val?.contacts?.[0]?.profile?.name || '',\n    message_body: msg.text?.body || ''\n  };\n} catch(e) { return { skip: true, challenge: '' }; }",
        "mode": "runOnceForEachItem"
      },
      "position": [
        224,
        192
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
