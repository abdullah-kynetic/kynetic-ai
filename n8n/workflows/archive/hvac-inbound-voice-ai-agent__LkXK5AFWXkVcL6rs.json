    {
      "id": "ad2783ec-b2b3-425f-bbdc-d5e0a7a0e3c7",
      "name": "Latest Tool Call ID",
      "parameters": {
        "jsCode": "// n8n Code Node - Latest ToolCallId Extractor\n// Ultra-efficient extraction of the latest toolCallId from webhook payload\n\ntry {\n  // Direct access to toolCalls array from webhook\n  const toolCalls = $('webhookVapi').first().json.body.message.toolCalls;\n  \n  // Fast validation and extraction\n  if (!Array.isArray(toolCalls) || toolCalls.length === 0) {\n    return [{\n      json: {\n        latestToolCallId: null,\n        error: 'No toolCalls found or empty array',\n        totalToolCalls: 0,\n        extractedAt: new Date().toISOString()\n      }\n    }];\n  }\n  \n  // Get the latest (last) toolCall - most efficient approach\n  const latestIndex = toolCalls.length - 1;\n  const latestToolCall = toolCalls[latestIndex];\n  \n  // Extract the ID with validation\n  const latestToolCallId = latestToolCall?.id || null;\n  \n  if (!latestToolCallId) {\n    return [{\n      json: {\n        latestToolCallId: null,\n        error: `ToolCall at index ${latestIndex} missing id property`,\n        totalToolCalls: toolCalls.length,\n        latestIndex: latestIndex,\n        extractedAt: new Date().toISOString()\n      }\n    }];\n  }\n  \n  // Success - return the latest toolCallId\n  return [{\n    json: {\n      latestToolCallId: latestToolCallId,\n      latestIndex: latestIndex,\n      totalToolCalls: toolCalls.length,\n      extractedAt: new Date().toISOString()\n    }\n  }];\n  \n} catch (error) {\n  // Error handling\n  return [{\n    json: {\n      latestToolCallId: null,\n      error: `Extraction failed: ${error.message}`,\n      totalToolCalls: 0,\n      extractedAt: new Date().toISOString()\n    }\n  }];\n}"
      },
      "position": [
        432,
        -128
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "d25f7f2f-a06d-4c0c-9c9f-107f71e0213d",
      "name": "Parameter Extraction",
      "parameters": {
        "jsCode": "// n8n Code Node: Fast Parameter Extractor - Parameters and Tool Names\n\nconst webhookData = $('webhookVapi').first().json;\nconst parameterPairs = [];\nconst toolNames = [];\n\ntry {\n  const toolCallList = webhookData?.body?.message?.toolCallList;\n  \n  if (toolCallList && Array.isArray(toolCallList)) {\n    toolCallList.forEach((toolCall, index) => {\n      if (toolCall?.function) {\n        // Collect tool name\n        if (toolCall.function.name) {\n          toolNames.push(toolCall.function.name);\n        }\n        \n        // Collect parameters\n        if (toolCall.function.arguments) {\n          Object.entries(toolCall.function.arguments).forEach(([key, value]) => {\n            parameterPairs.push(`${key}: ${value}`);\n          });\n        }\n      }\n    });\n  }\n  \n  const allParameters = parameterPairs.join(', ');\n  const allToolNames = toolNames.join(', ');\n  \n  return [{ json: { allParameters, allToolNames } }];\n  \n} catch (error) {\n  return [{ json: { allParameters: `error: ${error.message}`, allToolNames: '' } }];\n}"
      },
      "position": [
        656,
        -128
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
