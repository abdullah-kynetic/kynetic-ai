    {
      "id": "aa171eb0-79d1-4ccb-affa-900501ac7808",
      "name": "Code",
      "parameters": {
        "jsCode": "// Extract and format all available structured data\nconst items = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  \n  // Skip if missing critical data\n  if (!data.employer || !data.title) continue;\n  \n  // Extract location\n  const city = data.location?.city || '';\n  const state = data.location?.admin1Code || '';\n  const location = `${city}, ${state}`.trim().replace(/^,|,$/g, '') || 'Location unknown';\n  \n  // Extract salary\n  let salary = 'Not specified';\n  if (data.baseSalary) {\n    const min = data.baseSalary.min || '';\n    const max = data.baseSalary.max || '';\n    const unit = data.baseSalary.unitOfWork || 'HOUR';\n    if (min && max) {\n      salary = `$${min}-${max}/${unit.toLowerCase()}`;\n    } else if (min) {\n      salary = `$${min}/${unit.toLowerCase()}`;\n    }\n  }\n  \n  // Extract job type\n  let jobType = 'Not specified';\n  if (data.jobTypes && Object.keys(data.jobTypes).length > 0) {\n    jobType = Object.values(data.jobTypes)[0];\n  }\n  \n  // Extract benefits (format as bullet list)\n  let benefits = 'Not listed';\n  if (data.benefits && Object.keys(data.benefits).length > 0) {\n    const benefitsList = Object.values(data.benefits);\n    benefits = benefitsList.join('\\n• ');\n    benefits = '• ' + benefits;\n  }\n  \n  // Extract key attributes (top 10)\n  let keyAttributes = '';\n  if (data.attributes && Object.keys(data.attributes).length > 0) {\n    const attrList = Object.values(data.attributes).slice(0, 10);\n    keyAttributes = attrList.join(', ');\n  }\n  \n  // Determine industry from multiple sources\n  const industry = determineIndustry(data);\n  \n  // Calculate priority score\n  const priorityScore = calculatePriority(data, industry, jobType);\n  \n  // Format date posted\n  let datePosted = '';\n  if (data.datePublished) {\n    const date = new Date(data.datePublished);\n    datePosted = date.toISOString().split('T')[0];\n  }\n  \n  // Build comprehensive notes\n  const notes = buildNotes(data, salary, jobType, benefits);\n  \n  // Company URLs\n  const companyPageUrl = data.employer?.companyPageUrl || '';\n  const jobUrl = data.url || data.jobUrl || '';\n  \n  items.push({\n    json: {\n      businessName: data.employer.name || 'Unknown Company',\n      jobTitle: data.title || 'Unknown Position',\n      industry: industry,\n      location: location,\n      postalCode: data.location?.postalCode || '',\n      streetAddress: data.location?.streetAddress || '',\n      salary: salary,\n      jobType: jobType,\n      benefits: benefits,\n      jobUrl: jobUrl,\n      companyPageUrl: companyPageUrl,\n      datePosted: datePosted,\n      keyAttributes: keyAttributes,\n      source: 'Indeed',\n      status: 'New Lead',\n      priorityScore: priorityScore,\n      notes: notes\n    }\n  });\n}\n\nfunction determineIndustry(data) {\n  if (data.occupations) {\n    const occString = JSON.stringify(data.occupations).toLowerCase();\n    if (occString.includes('dental')) return 'Dental';\n    if (occString.includes('medical receptionist')) return 'Medical';\n    if (occString.includes('patient access')) return 'Medical';\n    if (occString.includes('healthcare')) return 'Medical';\n  }\n  \n  const companyName = (data.employer?.name || '').toLowerCase();\n  if (companyName.includes('dental')) return 'Dental';\n  if (companyName.includes('plastic surgery')) return 'Med Spa';\n  if (companyName.includes('med spa') || companyName.includes('medspa')) return 'Med Spa';\n  if (companyName.includes('urgent care')) return 'Medical';\n  if (companyName.includes('clinic')) return 'Medical';\n  if (companyName.includes('medical')) return 'Medical';\n  if (companyName.includes('restaurant')) return 'Restaurant';\n  if (companyName.includes('law')) return 'Law Firm';\n  if (companyName.includes('gym') || companyName.includes('fitness')) return 'Gym';\n  if (companyName.includes('salon') || companyName.includes('spa')) return 'Salon';\n  \n  const title = (data.title || '').toLowerCase();\n  if (title.includes('dental')) return 'Dental';\n  if (title.includes('medical')) return 'Medical';\n  \n  return 'Other';\n}\n\nfunction calculatePriority(data, industry, jobType) {\n  let score = 5;\n  \n  if (industry === 'Dental') score += 3;\n  if (industry === 'Med Spa') score += 3;\n  if (industry === 'Medical') score += 2;\n  if (industry === 'Law Firm') score += 1;\n  \n  if (data.datePublished) {\n    const postDate = new Date(data.datePublished);\n    const now = new Date();\n    const hoursSince = (now - postDate) / (1000 * 60 * 60);\n    if (hoursSince < 24) score += 2;\n    else if (hoursSince < 72) score += 1;\n  }\n  \n  if (jobType === 'Full-time') score += 1;\n  \n  if (data.baseSalary && data.baseSalary.min >= 20) score += 1;\n  \n  return Math.min(score, 10);\n}\n\nfunction buildNotes(data, salary, jobType, benefits) {\n  const companyName = data.employer?.name || 'Company';\n  const title = data.title || 'Position';\n  \n  let notes = `${title} at ${companyName}\\n\\n`;\n  notes += `💰 Salary: ${salary}\\n`;\n  notes += `⏰ Type: ${jobType}\\n\\n`;\n  \n  if (benefits !== 'Not listed') {\n    notes += `Benefits:\\n${benefits}\\n\\n`;\n  }\n  \n  if (data.description && data.description.text) {\n    const preview = data.description.text.substring(0, 400).trim();\n    notes += `Description:\\n${preview}...\\n\\n`;\n  }\n  \n  if (data.employer?.companyPageUrl) {\n    notes += `Indeed Company Page: ${data.employer.companyPageUrl}\\n`;\n  }\n  \n  return notes;\n}\n\nreturn items;"
      },
