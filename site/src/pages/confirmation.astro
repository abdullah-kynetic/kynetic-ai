---
import LegalPage from '../layouts/LegalPage.astro';
const body = `<p class="np-badge">You're booked</p>
<h1>Your AI audit is on the calendar.</h1>
<p id="when" hidden></p>
<p>We'll look at what you run today and what it costs you. We'll text you to confirm the call, and a calendar invite is on its way to your email.</p>
<h2>What to expect</h2>
<ul>
  <li>The call takes about 30 minutes and is free.</li>
  <li>Have a rough idea of how leads reach you, who follows up, and where the day-to-day work piles up.</li>
  <li>You leave with a list of where time and money slip away, and where AI pays back first.</li>
</ul>
<p><a class="np-btn np-btn--primary" href="/">Back to the home page</a></p>
<script>
try {
  var t = new URLSearchParams(location.search).get('t'); var d = t && new Date(t);
  if (d && !isNaN(d)) { var el = document.getElementById('when'); el.textContent = d.toLocaleString('en-US', { weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }); el.hidden = false; el.style.fontWeight = '600'; }
} catch (e) {}
</script>`;
---
<LegalPage title="You're booked | Kynetic AI" description="Your AI audit is booked." path="/confirmation/" body={body} noindex />
