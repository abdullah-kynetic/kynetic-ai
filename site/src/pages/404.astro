---
import LegalPage from '../layouts/LegalPage.astro';
const body = `<p class="np-badge">Page not found</p>
<h1>That page is not here.</h1>
<p>The link may be old or mistyped. The home page has everything, and the free AI Audit is one click away.</p>
<p><a class="np-btn np-btn--primary" href="/">Back to the home page</a></p>`;
---
<LegalPage title="Page not found | Kynetic AI" description="Page not found." path="/404/" body={body} noindex />
