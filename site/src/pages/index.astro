---
// Home page. Plain static HTML in the same simple flow as the niche pages: hero, why now, what changes,
// services, FAQ, final call to action. Every "audit" link points at the Cal page; audit-modal.ts turns
// each of them into the application overlay (without JS they still go to Cal).
import tokens from '../styles/tokens.css?raw';
import niche_css from '../styles/niche.css?raw';
import home_css from '../styles/home.css?raw';
import extras from '../styles/home-extras.css?raw';
import servicesMap from '../components/services-map.html?raw';

const CAL = 'https://cal.com/abdullah-kyneticai/kynetic-ai-discovery-call';
const title = 'Kynetic AI | Your AI Growth Partner';
const description = 'Kynetic AI finds where your business loses time and money, then designs, builds and runs the AI that fixes it. Start with a free AI audit.';
const url = new URL('/', Astro.site).href;
const ogImage = new URL('/brand/og-image-espresso.png', Astro.site).href;

const faqs = [
  { q: 'What does the free AI Audit cover?', a: 'A 30 minute call where we walk through how your whole business runs, from operations and admin to sales, customer service and management. You leave with a list of where time and money slip away, what each costs you, and where AI pays back first, whether or not you work with us.' },
  { q: 'What is the difference between the free AI Score and the free AI Audit?', a: 'The AI Score is a quick peek from the outside: what is visible about your business online, plus a few of your answers. The AI Audit is the look from the inside, a 30 minute call where we go through how your team, leads, tools and costs really work, and what each fix is worth.' },
  { q: 'What results can I expect, and how fast?', a: 'The timeline for your first system is agreed on your audit. We build, run and monitor it for you, and your client portal shows what each system produces. Results depend on your business, so we measure them with you rather than promise a number.' },
  { q: 'Will this add work for my team?', a: 'No. The point is to take work off your team.' },
  { q: 'Who owns what you build?', a: 'You do. The systems, data and accounts sit in your business, so what we build adds to what the company is worth.' },
];
const industries = ['Home services or construction', 'Roofing, HVAC, plumbing or electrical', 'Solar or energy', 'Landscaping, cleaning or pest control', 'Real estate or property management', 'Mortgage, insurance or finance', 'Law firm', 'Accounting or bookkeeping', 'Auto repair or dealership', 'Restaurant or hospitality', 'Retail or e-commerce', 'Fitness, beauty or salon', 'Education or tutoring', 'Veterinary or pet services', 'Staffing or recruiting', 'Marketing or creative agency', 'IT or software services', 'Manufacturing or logistics', 'Nonprofit'];
const questions = [
  { key: 'find', q: 'How do most new customers find you?', opts: ['Google or search', 'Referrals', 'Paid ads', 'Social media', 'Something else'] },
  { key: 'after', q: 'What happens when you miss a call or message after hours?', opts: ['Someone gets back to them the next day', 'They leave a voicemail or form and we call back later', 'Nothing, they usually move on', 'Something answers them right away'] },
  { key: 'volume', q: 'About how many leads or inquiries do you get a month?', opts: ['Under 20', '20 to 50', '50 to 150', 'Over 150'] },
  { key: 'follow', q: 'How do you follow up with leads?', opts: ['By hand, when we remember', 'With a CRM or reminders', 'We do not really follow up'] },
  { key: 'drain', q: 'Where does your team lose the most time?', opts: ['Admin and paperwork', 'Following up with leads', 'Scheduling', 'Answering the same questions', 'Something else'] },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#faf8f5" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style is:inline set:html={tokens} />
    <style is:inline set:html={niche_css} />
    <style is:inline set:html={home_css} />
    <style is:inline set:html={extras} />
  </head>
  <body class="np">
    <a class="kn-skip" href={CAL}>Skip to the audit request</a>
    <header class="np-nav">
      <div class="np-nav__pill">
        <a class="np-nav__logo" href="/" aria-label="Kynetic AI home"><img src="/brand/wordmark-a-light.svg" alt="Kynetic AI" width="124" height="28" /></a>
        <nav class="np-nav__links" aria-label="Page sections">
          <a href="#why">Why now</a>
          <a href="#change">What changes</a>
          <a href="#services">Services</a>
          <a href="#score">AI Score</a>
          <a href="#faq">FAQ</a>
        </nav>
        <a class="np-btn np-btn--primary np-btn--sm" href={CAL}>Book an audit</a>
      </div>
    </header>

    <main>
      <section class="np-hero np-hero--home" id="hero" data-motion="hero">
        <div class="np-wrap np-hero__inner">
          <p class="np-badge">AI growth partner</p>
          <h1>More Revenue, Less Busywork, and a Business That Runs Smarter.</h1>
          <p class="np-lede">We find where your business loses time and money, then design, build and run the AI that fixes it, from your first audit to a full AI transformation of how you run.</p>
          <div class="np-cta">
            <a class="np-btn np-btn--primary" href={CAL}>Book your free AI Audit</a>
            <p class="np-cta__note">A few quick questions, then choose a time. The call is free. Or <a href="#score">take a quick peek with the free AI Score</a>.</p>
          </div>
          <ul class="np-assure">
            <li>Free 30 minute AI Audit</li>
            <li>Built, run and monitored for you</li>
          </ul>
        </div>
      </section>

      <section class="np-section np-alt" id="why" data-motion="reveal">
        <div class="np-wrap np-why">
          <div>
            <p class="np-badge">Why now</p>
            <h2>Smarter systems.<br /><em>A fraction of the cost.</em></h2>
            <p>AI has made it far faster and cheaper to build software that fits how a business actually runs. Work that once took an agency months and a large budget now takes a small team a few weeks.</p>
            <p>Most businesses have not caught up. They still chase leads by hand, let quotes go quiet, and pay good people to retype the same details into three different tools.</p>
          </div>
          <div class="np-compare" role="group" aria-label="An example">
            <p class="np-compare__label">An example</p>
            <p class="np-compare__big"><strong>$280,000</strong><span>a month</span></p>
            <h3>A business that misses 40 inquiries a month</h3>
            <p class="np-compare__text">With a 20% close rate and a $35,000 average job, slow replies can leave this much work on the table every month.</p>
            <div class="np-bars" aria-label="Example reply time">
              <div class="np-bars__row"><span><b>Today</b><i>Replies when someone is free</i></span><div class="np-bars__track"><div class="np-bars__fill np-bars__fill--old" style="width:100%"></div></div></div>
              <div class="np-bars__row"><span><b>With a speed-to-lead system</b><i>Under 60 seconds</i></span><div class="np-bars__track"><div class="np-bars__fill" style="width:9%"></div></div></div>
            </div>
            <p class="np-compare__note">Example numbers only, not real results.</p>
          </div>
        </div>
      </section>

      <section class="np-section" id="change" data-motion="reveal">
        <div class="np-wrap">
          <header class="np-head">
            <p class="np-badge">What changes for you</p>
            <h2>Your best people get their time back.</h2>
            <p class="np-lede">We take the repetitive work off their plate, then build AI into the way they already work.</p>
          </header>
          <div class="np-change">
            <div class="np-stat">
              <strong>2–3×</strong>
              <b>as productive</b>
              <p>The lift your best people get once the busywork is handled and AI tools sit inside their day.</p>
            </div>
            <ul class="np-pillars">
              <li><span class="np-pillars__n">01</span><h3>Yours to keep</h3><p>The systems, data and accounts sit in your business's name, so what we build adds to what the company is worth.</p></li>
              <li><span class="np-pillars__n">02</span><h3>Fits your team</h3><p>We start from how your team already does the job, so people use the tools instead of working around them.</p></li>
              <li><span class="np-pillars__n">03</span><h3>One connected operation</h3><p>Leads, quotes, scheduling and reporting live in one place instead of across spreadsheets, inboxes and apps that never talk.</p></li>
            </ul>
          </div>
        </div>
      </section>

      <section class="np-section np-alt" id="services" data-motion="reveal">
        <div class="np-wrap">
          <header class="np-head">
            <p class="np-badge">Services</p>
            <h2>Start with the biggest opportunity.</h2>
            <p class="np-lede">The audit shows where AI pays back first. Every system is scoped on your audit, and nothing is switched on until you agree.</p>
          </header>
          <Fragment set:html={servicesMap} />
        </div>
      </section>

      <section class="np-section np-alt np-score" id="score" data-motion="score" data-gate="partial">
        <div class="np-wrap np-wrap--narrow">
          <header class="np-head">
            <p class="np-badge">Free AI Score</p>
            <h2>Take a peek under the hood.</h2>
            <p class="np-lede">A quick, outside-in look at how your business shows up online and where AI might fit. It takes about two minutes and it is free. It is a small taste of the free AI Audit, where we go inside the business.</p>
          </header>
          <div class="np-score__card" data-score aria-live="polite">
            <div class="np-score__bar"><span class="np-score__count" data-count>Step 1 of 4</span><span class="np-score__track"><i data-fill style="width:5%"></i></span></div>

            <form class="np-score__step" data-step="1" novalidate>
              <h3>Let's look at your business.</h3>
              <label>Business name<input name="biz" type="text" autocomplete="organization" maxlength="200" required /></label>
              <label><span>Website <em>(optional)</em></span><input name="site" type="text" inputmode="url" autocomplete="url" maxlength="200" placeholder="yourbusiness.com" /></label>
              <label>City and state<input name="loc" type="text" maxlength="120" placeholder="Austin, TX" /></label>
              <label class="np-score__check"><input name="online" type="checkbox" /> We are online only</label>
              <label>Industry<input name="industry" type="text" list="np-industries" maxlength="120" placeholder="Start typing, or enter your own" required /></label>
              <datalist id="np-industries">{industries.map((i) => <option value={i}></option>)}</datalist>
              <p class="np-score__err" role="alert" hidden></p>
              <button class="np-btn np-btn--primary" type="submit">Continue</button>
            </form>

            {questions.map((q, i) => (
              <form class="np-score__step" data-step={i + 2} hidden novalidate>
                <p class="np-score__qn">Question {i + 1} of {questions.length}</p>
                <h3>{q.q}</h3>
                <fieldset class="np-score__opts">
                  <legend class="np-sr">{q.q}</legend>
                  {q.opts.map((o, j) => <label class="np-score__opt"><input type="radio" name={q.key} value={o} /><span class="np-score__key">{'ABCDE'[j]}</span><span>{o}</span></label>)}
                </fieldset>
                <button class="np-score__back" type="button" data-back>&larr; Back</button>
              </form>
            ))}

            <div class="np-score__step np-score__run" data-step="run" hidden>
              <h3>Running your AI Score…</h3>
              <ul class="np-score__checks">
                <li data-check>Reading your Google profile</li>
                <li data-check>Comparing your reviews with nearby competitors</li>
                <li data-check>Asking AI assistants about your market</li>
                <li data-check>Scanning your website</li>
                <li data-check>Matching your answers to where AI could help</li>
              </ul>
            </div>

            <div class="np-score__step np-score__result" data-step="result" hidden>
              <p class="np-score__sample" data-sample>Preview with sample results. Live results switch on with the finished tool.</p>
              <h3 data-result-title>Your AI Score</h3>
              <p class="np-score__lens">A quick look from the outside, based on what is visible online and a few of your answers.</p>
              <div class="np-score__scores">
                <div class="np-score__big"><strong>58</strong><span>out of 100</span></div>
                <ul>
                  <li><span>Google presence and reviews</span><b>72</b></li>
                  <li><span>AI visibility</span><b>31</b></li>
                  <li><span>Website</span><b>64</b></li>
                  <li><span>Lead handling</span><b>45</b></li>
                </ul>
              </div>
              <h4>What we found</h4>
              <ol class="np-score__finds">
                <li>Sample finding: your review count is well below the top businesses near you.</li>
                <li>Sample finding: AI assistants did not name your business when asked for the best in your area.</li>
                <li>Sample finding: there is no way to book or chat outside business hours.</li>
              </ol>
              <h4>Quick wins</h4>
              <ul class="np-score__wins"><li>Sample win: reply to unanswered reviews.</li><li>Sample win: put a booking link at the top of your site.</li></ul>
              <h4>Where AI could help you</h4>
              <ul class="np-score__wins"><li>Answer missed calls and book after hours</li><li>Follow up with every inquiry within minutes</li></ul>
              <div class="np-score__vs" aria-label="The AI Score compared with the AI Audit">
                <div class="np-score__vs-col">
                  <p class="np-score__vs-label">Your AI Score</p>
                  <b>A quick look from the outside</b>
                  <ul><li>Based on what is public and a few answers</li><li>About two minutes, no call</li><li>Shows where to look first</li></ul>
                </div>
                <div class="np-score__vs-col np-score__vs-col--next">
                  <p class="np-score__vs-label">The free AI Audit</p>
                  <b>The full look from the inside</b>
                  <ul><li>A 30 minute call on how your team, leads, tools and costs really work</li><li>What each fix is worth</li><li>A clear plan for what to build first</li></ul>
                </div>
              </div>
              <div class="np-score__actions">
                <a class="np-btn np-btn--primary" href={CAL}>Book your free AI Audit (30 min)</a>
                <button class="np-btn np-btn--ghost" type="button" data-todo-backend="pdf">Download PDF</button>
                <button class="np-btn np-btn--ghost" type="button" data-todo-backend="email">Email me my report</button>
              </div>
              <p class="np-score__note" data-note hidden>Report delivery switches on with the finished tool.</p>
              <button class="np-score__back" type="button" data-restart>Start over</button>
            </div>
          </div>
        </div>
      </section>

      <section class="np-section" id="faq" data-motion="reveal">
        <div class="np-wrap">
          <header class="np-head">
            <p class="np-badge">FAQs</p>
            <h2>Straight answers.</h2>
          </header>
          <div class="np-faq">
            {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </div>
        </div>
      </section>

      <section class="np-band" id="book" data-motion="reveal">
        <div class="np-wrap np-wrap--narrow np-band__inner">
          <h2>Let's find where AI pays off first.</h2>
          <p>We look at how your business runs today, what it costs you, and where AI is worth building.</p>
          <a class="np-btn np-btn--primary" href={CAL}>Book your free AI Audit</a>
          <p class="np-band__cap">Prefer to reach us directly? <a href="tel:+19084779490">(908) 477-9490</a> or <a href="mailto:abdullah@kyneticai.com">abdullah@kyneticai.com</a></p>
        </div>
      </section>
    </main>

    <footer class="np-footer">
      <div class="np-wrap np-footer__inner">
        <a href="/" aria-label="Kynetic AI home"><img src="/brand/wordmark-a-espresso.svg" alt="Kynetic AI" width="124" height="28" /></a>
        <p>An AI growth partner that finds your leaks, then builds and runs the AI systems that fix them.</p>
        <nav aria-label="Footer"><a href="/">Home</a><a href="/remodelers">Remodelers</a><a href="/privacy">Privacy Policy</a><a href="/terms">Terms &amp; Conditions</a></nav>
      </div>
    </footer>
    <script>
      import { initAuditModal } from '../scripts/audit-modal';
      import { initMapPop } from '../scripts/map-pop';
      import { initReveal } from '../scripts/reveal';
      initAuditModal();
      initMapPop();
      import { initScore } from '../scripts/score';
      initReveal();
      initScore();
    </script>
  </body>
</html>
