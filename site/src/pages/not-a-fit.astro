---
import Page from '../layouts/Page.astro';
const head = `<meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Thanks for applying | Kynetic AI</title><meta name="robots" content="noindex"><link rel="canonical" href="https://www.kyneticai.com/not-a-fit/">`;
const body = `<div class="nf">
  <header class="nf__nav"><a href="/" aria-label="Kynetic AI home"><img src="/brand/wordmark-a-light.svg" alt="Kynetic AI" width="124" height="28" /></a></header>
  <main class="nf__main"><section class="nf__card">
    <span class="am__pill"><i></i>Thanks for applying</span>
    <h1 class="nf__title">We're not the right fit yet.</h1>
    <p>Thanks for telling us about your business. We build for established businesses that are ready to invest in a custom system, so a call wouldn't help you yet.</p>
    <p>Your answers are saved. If things change, you're welcome to come back.</p>
  </section></main>
</div>`;
---
<Page head={head} css="" body={body} script={false} />
