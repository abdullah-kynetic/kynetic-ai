---
// Wraps a snapshot page (markup + CSS exported from the published site, see scripts/snapshot.mjs).
interface Props { head: string; css: string; body: string; script?: boolean }
import tokens from '../styles/tokens.css?raw';
import components from '../styles/components.css?raw';
import sections from '../styles/sections.css?raw';
import calc from '../styles/calc.css?raw';
const { head, css, body, script = true } = Astro.props;
const site = Astro.site!.origin;
// The snapshot's own favicon and social-image tags are dropped; the brand set below replaces them.
const absHead = head
  .replace(/<link[^>]*rel="icon"[^>]*>\s*/g, '')
  .replace(/<meta[^>]*(?:property="og:image"|name="twitter:(?:image|card)")[^>]*>\s*/g, '')
  .replace(/(content|href)="(\/assets\/[^"]+)"/g, `$1="${site}$2"`);
const ogImage = new URL('/brand/og-image-espresso.png', Astro.site).href;
---
<!doctype html>
<html lang="en" data-redirect-timezone="1">
  <head>
    <Fragment set:html={absHead} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#faf8f5" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style is:inline set:html={tokens} />
    <style is:inline set:html={css} />
    <style is:inline set:html={components} />
    <style is:inline set:html={sections} />
    <style is:inline set:html={calc} />
  </head>
  <body>
    <Fragment set:html={body} />
    {script && <script src="../scripts/main.ts"></script>}
  </body>
</html>
