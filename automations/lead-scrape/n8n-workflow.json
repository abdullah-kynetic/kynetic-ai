{
  "name": "Kynetic — Lead Scrape (Apify → Notion Outreach)",
  "id": "3orAiCNLOCJ7xglI",
  "description": "KYNETIC AI. n8n Form → Modal/Apify scrape → Notion dedup → Notion Outreach DB. Updates Scrape Queries row with stats on success, marks Failed with error details. Powers Phase 1 lead sourcing across the 8 niches.",
  "connections": {
    "Scrape Form": { "main": [[{ "node": "Extract Fields from Form", "type": "main", "index": 0 }]] },
    "Extract Fields from Form": { "main": [[{ "node": "Create Scrape Query Row", "type": "main", "index": 0 }]] },
    "Create Scrape Query Row": { "main": [[{ "node": "Call Modal Scrape API", "type": "main", "index": 0 }]] },
    "Call Modal Scrape API": { "main": [[{ "node": "Check Scrape Success", "type": "main", "index": 0 }]] },
    "Check Scrape Success": {
      "main": [
        [{ "node": "Mark Scrape Query Complete", "type": "main", "index": 0 }],
        [{ "node": "Mark Scrape Query Failed", "type": "main", "index": 0 }]
      ]
    },
    "Mark Scrape Query Complete": { "main": [[{ "node": "Append Results to Scrape Query Page", "type": "main", "index": 0 }]] },
    "Mark Scrape Query Failed": { "main": [[{ "node": "Append Error to Scrape Query Page", "type": "main", "index": 0 }]] }
  },
  "nodes": [
    {
      "parameters": {
        "formTitle": "Kynetic AI — Scrape Leads",
        "formDescription": "Submit a Google Maps scrape job. Results populate the Outreach database automatically.",
        "formFields": {
          "values": [
            { "fieldLabel": "Niche", "fieldType": "dropdown", "fieldOptions": { "values": [
              { "option": "Restoration" },
              { "option": "roofing contractor" },
              { "option": "foundation repair service" },
              { "option": "tree service" },
              { "option": "swimming pool contractor" },
              { "option": "septic system service" },
              { "option": "land clearing service" },
              { "option": "commercial painting contractor" }
            ] }, "requiredField": true },
            { "fieldLabel": "Location", "placeholder": "e.g. Dallas, TX", "requiredField": true },
            { "fieldLabel": "Max Places", "fieldType": "number", "defaultValue": "25", "requiredField": true },
            { "fieldLabel": "Website Filter", "fieldType": "dropdown", "fieldOptions": { "values": [
              { "option": "All Places" }, { "option": "With Website" }, { "option": "Without Website" }
            ] }, "requiredField": true },
            { "fieldLabel": "Skip Closed", "fieldType": "checkbox", "fieldOptions": { "values": [{}] } }
          ]
        },
        "options": {}
      },
      "id": "881ba272-e344-416c-827c-21a4e9c68dfd",
      "name": "Scrape Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [272, 128],
      "webhookId": "8fd96c2e-6faf-498f-ba9f-fe8e283d53a9"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "niche", "name": "niche", "value": "={{ $json['Niche'] || null }}", "type": "string" },
            { "id": "location", "name": "location", "value": "={{ $json['Location'] || null }}", "type": "string" },
            { "id": "max_places", "name": "max_places", "value": "={{ Number($json['Max Places']) || 25 }}", "type": "number" },
            { "id": "website_filter_label", "name": "website_filter_label", "value": "={{ $json['Website Filter'] || 'All Places' }}", "type": "string" },
            { "id": "website_filter", "name": "website_filter", "value": "={{ $json['Website Filter'] === 'With Website' ? 'withWebsite' : $json['Website Filter'] === 'Without Website' ? 'withoutWebsite' : 'allPlaces' }}", "type": "string" },
            { "id": "skip_closed", "name": "skip_closed", "value": "={{ $json['Skip Closed'] === true || $json['Skip Closed'] === 'on' || $json['Skip Closed'] === 'true' }}", "type": "boolean" }
          ]
        },
        "options": {}
      },
      "id": "9a1772f3-9d53-42f8-80b6-7a5f9651ccd7",
      "name": "Extract Fields from Form",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 128]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "databasePage",
        "databaseId": { "__rl": true, "value": "df6ef747-ac12-48b5-9a50-d791b349e75c", "mode": "list", "cachedResultName": "📋 Scrape Queries", "cachedResultUrl": "https://app.notion.com/p/df6ef747ac1248b59a50d791b349e75c" },
        "title": "={{ $json.niche + ' — ' + $json.location }}",
        "propertiesUi": { "propertyValues": [
          { "key": "Status|select", "type": "select", "selectValue": "Running" },
          { "key": "Location|rich_text", "type": "rich_text", "textContent": "={{ $json.location }}" },
          { "key": "Max Places|number", "type": "number", "numberValue": "={{ $json.max_places }}" },
          { "key": "Website Filter|select", "type": "select", "selectValue": "={{ $json.website_filter_label }}" },
          { "key": "Skip Closed|checkbox", "type": "checkbox", "checkboxValue": "={{ $json.skip_closed }}" },
          { "key": "Run Date|date", "type": "date", "date": "={{ new Date().toISOString().split('T')[0] }}" },
          { "key": "Niche|select", "type": "select", "selectValue": "={{ $json.niche }}" }
        ] },
        "options": {}
      },
      "id": "2afd6ad4-f3d2-44a6-8813-3a177a04661b",
      "name": "Create Scrape Query Row",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [704, 128],
      "credentials": { "notionOAuth2Api": { "id": "pPuCuC18ekEbAfp0", "name": "Notion account" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://abdullah-33790--kynetic-agency-os-api-scrape-leads.modal.run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": { "parameters": [
          { "name": "niche", "value": "={{ $('Extract Fields from Form').first().json.niche }}" },
          { "name": "location", "value": "={{ $('Extract Fields from Form').first().json.location }}" },
          { "name": "max_places", "value": "={{ $('Extract Fields from Form').first().json.max_places }}" },
          { "name": "website_filter", "value": "={{ $('Extract Fields from Form').first().json.website_filter }}" },
          { "name": "skip_closed", "value": "={{ $('Extract Fields from Form').first().json.skip_closed }}" }
        ] },
        "options": { "timeout": 1300000 }
      },
      "id": "73616c2b-ec75-42dd-90b2-8e1f9eedf545",
      "name": "Call Modal Scrape API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [928, 128],
      "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "eq498KfHgSxtVu0O", "name": "Header Auth account 2" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [{ "id": "check-leads", "leftValue": "={{ $json.leads_added }}", "rightValue": "", "operator": { "type": "number", "operation": "exists", "singleValue": true } }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d79a7361-5221-4720-becb-57c6fe376b93",
      "name": "Check Scrape Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1152, 128]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "databasePage",
        "operation": "update",
        "pageId": { "__rl": true, "mode": "id", "value": "={{ $('Create Scrape Query Row').first().json.id }}" },
        "propertiesUi": { "propertyValues": [
          { "key": "Status|select", "type": "select", "selectValue": "Complete" },
          { "key": "Leads Added|number", "type": "number", "numberValue": "={{ $json.leads_added }}" },
          { "key": "Leads Skipped|number", "type": "number", "numberValue": "={{ $json.leads_skipped }}" },
          { "key": "Total Found|number", "type": "number", "numberValue": "={{ $json.total_found }}" },
          { "key": "Run Date|date", "type": "date", "date": "={{ new Date().toISOString().split('T')[0] }}" },
          { "key": "Notes|rich_text", "type": "rich_text", "textContent": "={{ $json.leads_failed > 0 ? '⚠️ ' + $json.leads_failed + ' lead(s) failed to write to Outreach — check Modal logs' : '' }}" }
        ] },
        "options": {}
      },
      "id": "36ef40b1-0dcc-463d-8b75-ae0753c79da8",
      "name": "Mark Scrape Query Complete",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1376, 0],
      "executeOnce": true,
      "credentials": { "notionOAuth2Api": { "id": "pPuCuC18ekEbAfp0", "name": "Notion account" } }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "block",
        "blockId": { "__rl": true, "mode": "id", "value": "={{ $('Create Scrape Query Row').first().json.id }}" },
        "blockUi": { "blockValues": [{ "textContent": "={{ '✅ Scrape complete — ' + $json.property_leads_added + ' leads added, ' + $json.property_leads_skipped + ' skipped (' + $json.property_total_found + ' total found).' }}" }] }
      },
      "id": "fb694910-5505-4de5-a544-bd369edb9d94",
      "name": "Append Results to Scrape Query Page",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1600, 0],
      "executeOnce": true,
      "credentials": { "notionOAuth2Api": { "id": "pPuCuC18ekEbAfp0", "name": "Notion account" } }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "databasePage",
        "operation": "update",
        "pageId": { "__rl": true, "mode": "id", "value": "={{ $('Create Scrape Query Row').first().json.id }}" },
        "propertiesUi": { "propertyValues": [{ "key": "Status|select", "type": "select", "selectValue": "Failed" }] },
        "options": {}
      },
      "id": "d20ec072-4c4d-4ef9-97ae-85fdb96e7483",
      "name": "Mark Scrape Query Failed",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1376, 320],
      "credentials": { "notionOAuth2Api": { "id": "pPuCuC18ekEbAfp0", "name": "Notion account" } }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "block",
        "blockId": { "__rl": true, "mode": "id", "value": "={{ $('Create Scrape Query Row').first().json.id }}" },
        "blockUi": { "blockValues": [{ "textContent": "={{ '❌ Scrape failed — ' + ($json.error?.message || $json.message || 'Unknown error') + ' (' + new Date().toISOString() + ')' }}" }] }
      },
      "id": "1d1fba82-e6e4-4a0b-a8ec-13f58ef9b4c4",
      "name": "Append Error to Scrape Query Page",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1600, 320],
      "credentials": { "notionOAuth2Api": { "id": "pPuCuC18ekEbAfp0", "name": "Notion account" } }
    }
  ]
}
