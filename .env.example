# Copy to .env locally (never commit .env). In Claude Code cloud, set these as environment variables.

# Retell AI (tools/retell.py and the Retell MCP)
RETELL_API_KEY=

# Cal.com (Kynetic Restoration booking; also injected into Retell Cal tools)
CAL_API_KEY=

# Research / scraping MCPs
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# n8n (tools/n8n_backup.py, read-only)
N8N_BASE_URL=
N8N_API_KEY=

# Twenty CRM (system of record; the same instance n8n and the claude.ai connector use)
TWENTY_API_KEY=
TWENTY_BASE_URL=https://crm.kyneticai.com
